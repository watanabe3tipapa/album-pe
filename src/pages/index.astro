---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const albumAppUrl = import.meta.env.PUBLIC_ALBUM_APP_URL || withBase('albums');
---

<Layout
  title="共有アルバムを、やさしく始める"
  description="共有アルバム用LPのつくり方を学び、そのまま写真を集められるAlbum PE。家族・友人・イベントの思い出を、招待した人とだけ共有できます。"
>
  <main id="main-content">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">GUIDE + SHARED ALBUM</p>
          <h1>写真を集める場所を、<br /><em>やさしく設計する。</em></h1>
          <p class="hero-lead">Album PEは、共有アルバム用LPのつくり方を学びながら、実際にアルバムを作って写真を集められる場所です。大切な思い出を、招待した人とだけ共有できます。</p>
          <div class="hero-actions">
            <a class="button" href={albumAppUrl}>アルバムをはじめる <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#guide">つくり方を読む <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note"><span aria-hidden="true">●</span> アルバムの閲覧・投稿は認証された参加者だけに公開されます。</p>
        </div>
        <div class="hero-visual" aria-label="共有アルバムのイメージ">
          <div class="visual-card main-photo">
            <img src={withBase('images/photo-sharing-hero.jpeg')} alt="スマートフォンで写真を一緒に見る二人" />
            <div class="photo-caption"><span>Weekend memories</span><strong>24 photos</strong></div>
          </div>
          <div class="visual-card mini-card mini-top"><span class="mini-icon" aria-hidden="true">+</span><span>みんなの写真を<br />ひとつの場所に</span></div>
          <div class="visual-card mini-card mini-bottom"><span class="avatars" aria-hidden="true"><i>Y</i><i>M</i><i>S</i></span><span>招待した仲間と共有</span></div>
          <span class="orb orb-one" aria-hidden="true"></span><span class="orb orb-two" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <section id="guide" class="guide-section">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">HOW TO MAKE A LANDING PAGE</p>
          <h2>共有アルバムLPは、<br />4つの順番でつくる。</h2>
          <p>大切なのは、機能を並べることではありません。「誰が、どんな思い出を、どう残したいか」を最初に置くことです。</p>
        </div>
        <div class="steps">
          <article class="step-card">
            <span class="step-number">01</span>
            <h3>共有する相手を決める</h3>
            <p>家族旅行、結婚式、部活動、イベント。誰が参加するかを決めると、必要な説明と招待の方法が見えてきます。</p>
          </article>
          <article class="step-card">
            <span class="step-number">02</span>
            <h3>最初の一歩をひとつにする</h3>
            <p>LPでは「アルバムをつくる」だけを主役に。迷いを減らす短い導線が、参加のきっかけになります。</p>
          </article>
          <article class="step-card">
            <span class="step-number">03</span>
            <h3>安心できる理由を伝える</h3>
            <p>写真は個人的なものです。認証、参加者の管理、非公開の配信を明示して、共有への不安を取り除きます。</p>
          </article>
          <article class="step-card">
            <span class="step-number">04</span>
            <h3>使い始めた後を想像させる</h3>
            <p>作成、招待、アップロード、振り返りまでを見せれば、訪れた人は自分の思い出を重ねて考えられます。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="blueprint-section">
      <div class="shell blueprint-grid">
        <div class="blueprint-copy">
          <p class="eyebrow">LP BLUEPRINT</p>
          <h2>読む人の気持ちを、<br />使う人の行動へ。</h2>
          <p>Album PEのLPは、価値の提示、つくり方、安心の説明、開始ボタンという流れで設計されています。あなたのサービスでも、この順番を土台にできます。</p>
          <a class="button button-secondary" href={albumAppUrl}>実際の体験を開く <span aria-hidden="true">→</span></a>
        </div>
        <ol class="blueprint-list">
          <li><span>01</span><div><strong>共感する情景</strong><p>「写真が散らばっている」という日常の困りごとを、短い言葉と写真で描きます。</p></div></li>
          <li><span>02</span><div><strong>解決する流れ</strong><p>つくる・招待する・集める、という体験を分解して、初めての人にも伝えます。</p></div></li>
          <li><span>03</span><div><strong>安心の設計</strong><p>誰に見せるかを決められることを、機能ではなく約束として伝えます。</p></div></li>
          <li><span>04</span><div><strong>迷わない行動</strong><p>説明を読み終えた場所に、すぐ始められるボタンを置きます。</p></div></li>
        </ol>
      </div>
    </section>

    <section id="features" class="features-section">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">BUILT TO BE USED</p>
          <h2>解説で終わらない、<br />実際に使える共有アルバム。</h2>
          <p>作り方を読んだら、そのまま自分のアルバムを始められます。操作はシンプルに、写真の扱いは慎重に設計しています。</p>
        </div>
        <div class="feature-grid">
          <article class="feature-card feature-highlight"><span class="feature-icon" aria-hidden="true">□</span><h3>アルバムをすぐ作成</h3><p>タイトルと説明を入力するだけで、思い出の居場所を用意できます。</p></article>
          <article class="feature-card"><span class="feature-icon" aria-hidden="true">↥</span><h3>複数の写真を追加</h3><p>ドラッグ＆ドロップにも対応。みんなの写真を、ひとつずつ確実に集められます。</p></article>
          <article class="feature-card"><span class="feature-icon" aria-hidden="true">◎</span><h3>参加者ごとに共有</h3><p>閲覧のみ、または投稿もできる参加者を、アルバムごとに管理できます。</p></article>
          <article class="feature-card"><span class="feature-icon" aria-hidden="true">⌁</span><h3>非公開の画像配信</h3><p>アルバムの権限を確認してから写真を配信するため、URLだけでは閲覧できません。</p></article>
        </div>
      </div>
    </section>

    <section class="flow-section">
      <div class="shell flow-panel">
        <div><p class="eyebrow">YOUR FIRST ALBUM</p><h2>つくる。招待する。<br />思い出が集まる。</h2></div>
        <div class="flow-items" aria-label="利用の流れ"><span><b>1</b>アルバムを作成</span><i aria-hidden="true">→</i><span><b>2</b>参加者を追加</span><i aria-hidden="true">→</i><span><b>3</b>写真をアップロード</span></div>
      </div>
    </section>

    <section class="cta-section">
      <div class="shell cta-panel">
        <p class="eyebrow">READY WHEN YOU ARE</p>
        <h2>最初のアルバムから、<br />思い出の共有を始めよう。</h2>
        <p>認証済みの参加者だけがアクセスできる、あなたたちの写真置き場です。</p>
        <a class="button cta-button" href={albumAppUrl}>アルバムをはじめる <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero { overflow: hidden; padding: clamp(64px, 10vw, 132px) 0 96px; background: radial-gradient(circle at 85% 15%, #e5f2ef 0, rgba(229,242,239,0) 32%), var(--paper); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr); align-items: center; gap: clamp(40px, 7vw, 96px); }
  .hero-copy h1 { max-width: 660px; margin: 0; font-size: clamp(43px, 6.2vw, 74px); letter-spacing: -0.075em; line-height: 1.09; }
  .hero-copy h1 em { color: var(--accent); font-style: normal; }
  .hero-lead { max-width: 580px; margin: 26px 0 0; color: var(--ink-soft); font-size: 17px; line-height: 1.9; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 32px; }
  .text-link { color: var(--ink); font-size: 14px; font-weight: 750; text-underline-offset: 5px; }
  .hero-note { margin: 26px 0 0; color: var(--ink-soft); font-size: 12px; }
  .hero-note span { margin-right: 6px; color: #2a9586; font-size: 10px; }
  .hero-visual { position: relative; min-height: 445px; }
  .visual-card { position: absolute; border: 1px solid rgba(255,255,255,.8); background: #fff; box-shadow: var(--shadow); }
  .main-photo { top: 10px; right: 12px; width: min(100%, 412px); padding: 11px; border-radius: 24px; transform: rotate(3deg); }
  .main-photo img { display: block; width: 100%; height: 306px; border-radius: 16px; object-fit: cover; object-position: center; }
  .photo-caption { display: flex; align-items: center; justify-content: space-between; padding: 15px 6px 4px; color: var(--ink); font-size: 13px; }
  .photo-caption strong { color: var(--ink-soft); font-size: 11px; font-weight: 650; }
  .mini-card { display: flex; align-items: center; gap: 11px; border-radius: 14px; padding: 14px; color: var(--ink); font-size: 12px; line-height: 1.45; font-weight: 700; }
  .mini-top { top: 74px; left: 0; z-index: 2; transform: rotate(-5deg); }
  .mini-bottom { right: -8px; bottom: 18px; z-index: 2; transform: rotate(-3deg); }
  .mini-icon { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; font-size: 21px; font-weight: 400; }
  .avatars { display: flex; }
  .avatars i { display: grid; width: 25px; height: 25px; margin-left: -5px; place-items: center; border: 2px solid #fff; border-radius: 50%; background: #a5ccc4; color: #173e3d; font-size: 9px; font-style: normal; }
  .avatars i:nth-child(2) { background: #f5bda9; color: #773827; }.avatars i:nth-child(3) { background: #b9c6e4; color: #37456d; }
  .orb { position: absolute; border-radius: 50%; filter: blur(1px); }
  .orb-one { top: 14px; left: 16%; width: 68px; height: 68px; background: #f4bd65; }.orb-two { bottom: 33px; left: 14%; width: 26px; height: 26px; background: #89c8ba; }
  .guide-section, .features-section { padding: clamp(72px, 10vw, 120px) 0; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step-card { min-height: 236px; padding: 25px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); transition: transform 180ms ease, box-shadow 180ms ease; }
  .step-card:hover { box-shadow: 0 16px 32px rgba(16,35,63,.08); transform: translateY(-5px); }
  .step-number { color: var(--accent); font-size: 12px; font-weight: 850; letter-spacing: .06em; }.step-card h3 { margin: 44px 0 10px; font-size: 18px; letter-spacing: -.03em; }.step-card p { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.75; }
  .blueprint-section { padding: clamp(72px, 10vw, 120px) 0; background: var(--ink); color: #fff; }.blueprint-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(48px, 10vw, 130px); align-items: center; }.blueprint-copy h2 { margin: 0; font-size: clamp(32px, 4vw, 49px); letter-spacing: -.055em; line-height: 1.17; }.blueprint-copy > p:not(.eyebrow) { max-width: 460px; margin: 23px 0 30px; color: #c5d1e3; line-height: 1.85; }.blueprint-copy .eyebrow { color: #f4bd65; }.blueprint-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(255,255,255,.2); }.blueprint-list li { display: grid; grid-template-columns: 55px 1fr; gap: 16px; padding: 22px 0; border-bottom: 1px solid rgba(255,255,255,.2); }.blueprint-list li > span { color: #f4bd65; font-size: 12px; font-weight: 800; }.blueprint-list strong { font-size: 16px; }.blueprint-list p { margin: 8px 0 0; color: #c5d1e3; font-size: 14px; line-height: 1.7; }
  .feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }.feature-card { min-height: 230px; padding: 25px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }.feature-highlight { background: var(--mint); border-color: #c4e4de; }.feature-icon { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 10px; background: var(--ink); color: #fff; font-size: 20px; }.feature-card h3 { margin: 28px 0 8px; font-size: 17px; letter-spacing: -.03em; }.feature-card p { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.7; }
  .flow-section { padding: 0 0 clamp(72px, 10vw, 120px); }.flow-panel { display: grid; grid-template-columns: .9fr 1.1fr; gap: 40px; align-items: end; padding: clamp(32px, 5vw, 58px); border-radius: 22px; background: #f1e7db; }.flow-panel h2 { margin: 0; font-size: clamp(28px, 4vw, 43px); letter-spacing: -.05em; line-height: 1.2; }.flow-items { display: flex; align-items: center; justify-content: space-between; gap: 12px; }.flow-items span { display: grid; gap: 8px; color: var(--ink); font-size: 13px; font-weight: 750; }.flow-items b { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; font-size: 12px; }.flow-items i { color: #a8855b; font-style: normal; }
  .cta-section { padding: 0 0 clamp(72px, 10vw, 120px); }.cta-panel { padding: clamp(52px, 8vw, 92px) 24px; border-radius: 24px; background: radial-gradient(circle at 75% 20%, rgba(231,115,79,.22), transparent 25%), var(--ink); color: #fff; text-align: center; }.cta-panel .eyebrow { color: #f4bd65; }.cta-panel h2 { margin: 0; font-size: clamp(32px, 5vw, 54px); letter-spacing: -.06em; line-height: 1.13; }.cta-panel > p:not(.eyebrow) { margin: 18px 0 28px; color: #c5d1e3; line-height: 1.7; }.cta-button { background: var(--accent); }.cta-button:hover { background: var(--accent-dark); }
  @media (max-width: 900px) { .hero-grid, .blueprint-grid, .flow-panel { grid-template-columns: 1fr; }.hero-visual { width: min(100%, 490px); margin: 10px auto 0; }.steps, .feature-grid { grid-template-columns: repeat(2, 1fr); }.flow-items { justify-content: flex-start; }.flow-panel { align-items: start; } }
  @media (max-width: 540px) { .hero { padding-top: 62px; }.hero-copy h1 { font-size: 42px; }.hero-visual { min-height: 365px; }.main-photo { width: 85%; right: 0; }.main-photo img { height: 250px; }.mini-top { top: 50px; }.mini-bottom { bottom: 5px; }.steps, .feature-grid { grid-template-columns: 1fr; }.step-card, .feature-card { min-height: auto; }.step-card h3 { margin-top: 28px; }.flow-items { flex-direction: column; align-items: flex-start; }.flow-items i { margin-left: 10px; transform: rotate(90deg); }.cta-panel h2 { font-size: 35px; } }
</style>
