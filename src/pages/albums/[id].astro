---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="共有アルバム" description="招待した参加者と写真を集め、思い出を共有するアルバムです。">
  <main id="main-content" class="album-page">
    <div class="shell">
      <a class="back-link" href="/albums"><span aria-hidden="true">←</span> アルバム一覧へ</a>
      <section class="album-head" aria-labelledby="album-title">
        <div class="album-title-area">
          <p id="album-role" class="eyebrow">SHARED ALBUM</p>
          <h1 id="album-title">アルバムを読み込んでいます</h1>
          <p id="album-description">写真と参加者の情報を確認しています。</p>
        </div>
        <div id="album-actions" class="album-actions"></div>
      </section>

      <div id="album-status" class="status" role="status" aria-live="polite"></div>
      <section id="upload-section" class="upload-section" hidden aria-labelledby="upload-title">
        <div id="upload-area" class="upload-area" role="button" tabindex="0" aria-describedby="upload-hint">
          <span class="upload-icon" aria-hidden="true">↑</span>
          <div><h2 id="upload-title">写真を追加する</h2><p id="upload-hint">クリックまたは写真をドラッグ＆ドロップ。JPEG・PNG・WebP・AVIF・GIF、1枚10MBまで。</p></div>
          <input id="file-input" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" multiple hidden />
        </div>
        <div id="upload-progress" class="upload-progress" aria-live="polite"></div>
      </section>

      <section class="photos-section" aria-labelledby="photos-heading">
        <div class="section-bar"><h2 id="photos-heading">写真 <span id="photo-count">0</span></h2><p id="permission-note"></p></div>
        <div id="image-grid" class="image-grid" aria-busy="true"></div>
      </section>
    </div>
  </main>

  <dialog id="members-dialog" aria-labelledby="members-title">
    <div class="dialog-content">
      <div class="dialog-heading"><div><p class="eyebrow">PARTICIPANTS</p><h2 id="members-title">参加者を管理する</h2></div><button class="dialog-close" type="button" data-close="members-dialog" aria-label="閉じる">×</button></div>
      <p class="dialog-lead">参加者はこのアルバムだけを閲覧・投稿できます。利用には、各メールアドレスをCloudflare Accessの許可ポリシーにも追加してください。</p>
      <form id="member-form" class="member-form">
        <label>メールアドレス<input name="email" type="email" required maxlength="320" placeholder="friend@example.com" autocomplete="email" /></label>
        <label>権限<select name="permission"><option value="contributor">閲覧・写真追加</option><option value="viewer">閲覧のみ</option></select></label>
        <button class="button" type="submit">参加者を追加</button>
      </form>
      <div id="member-status" class="status" role="status" aria-live="polite"></div>
      <ul id="member-list" class="member-list" aria-label="参加者一覧"></ul>
    </div>
  </dialog>

  <dialog id="edit-dialog" aria-labelledby="edit-title">
    <form id="edit-form" class="dialog-content" method="dialog">
      <div class="dialog-heading"><div><p class="eyebrow">ALBUM SETTINGS</p><h2 id="edit-title">アルバムを編集する</h2></div><button class="dialog-close" value="cancel" type="submit" aria-label="閉じる">×</button></div>
      <label>アルバム名<input id="edit-album-title" name="title" required maxlength="120" /></label>
      <label>説明<textarea id="edit-album-description" name="description" rows="4" maxlength="1000"></textarea></label>
      <div class="dialog-actions"><button class="button button-secondary" value="cancel" type="submit">キャンセル</button><button id="edit-submit" class="button" value="default" type="submit">保存する</button></div>
    </form>
  </dialog>

  <dialog id="lightbox" class="lightbox" aria-label="写真を拡大表示">
    <button class="lightbox-close" type="button" data-close="lightbox" aria-label="閉じる">×</button><img id="lightbox-image" alt="" />
  </dialog>

  <dialog id="delete-dialog" aria-labelledby="delete-title">
    <form id="delete-form" class="dialog-content" method="dialog">
      <div class="dialog-heading"><div><p class="eyebrow">DELETE ALBUM</p><h2 id="delete-title">このアルバムを削除しますか？</h2></div><button class="dialog-close" value="cancel" type="submit" aria-label="閉じる">×</button></div>
      <p class="dialog-lead">アルバム、参加者、保存済みの写真はすべて削除されます。この操作は取り消せません。</p>
      <div class="dialog-actions"><button class="button button-secondary" value="cancel" type="submit">キャンセル</button><button id="delete-submit" class="button danger-button" value="default" type="submit">すべて削除する</button></div>
    </form>
  </dialog>
</Layout>

<script>
  interface Album { id: string; title: string; description: string; }
  interface Photo { id: string; filename: string; mime_type: string; file_size: number; created_at: string; }
  interface AlbumPayload { album: Album; images: Photo[]; isOwner: boolean; canUpload: boolean; permission: string; }
  interface Member { member_email: string; permission: 'viewer' | 'contributor'; created_at: string; }

  const albumId = window.location.pathname.split('/').filter(Boolean).pop() ?? '';
  const titleElement = document.querySelector<HTMLHeadingElement>('#album-title')!;
  const descriptionElement = document.querySelector<HTMLParagraphElement>('#album-description')!;
  const roleElement = document.querySelector<HTMLParagraphElement>('#album-role')!;
  const actionsElement = document.querySelector<HTMLDivElement>('#album-actions')!;
  const grid = document.querySelector<HTMLDivElement>('#image-grid')!;
  const photoCount = document.querySelector<HTMLSpanElement>('#photo-count')!;
  const permissionNote = document.querySelector<HTMLParagraphElement>('#permission-note')!;
  const status = document.querySelector<HTMLDivElement>('#album-status')!;
  const uploadSection = document.querySelector<HTMLElement>('#upload-section')!;
  const uploadArea = document.querySelector<HTMLDivElement>('#upload-area')!;
  const input = document.querySelector<HTMLInputElement>('#file-input')!;
  const progress = document.querySelector<HTMLDivElement>('#upload-progress')!;
  const membersDialog = document.querySelector<HTMLDialogElement>('#members-dialog')!;
  const editDialog = document.querySelector<HTMLDialogElement>('#edit-dialog')!;
  const deleteDialog = document.querySelector<HTMLDialogElement>('#delete-dialog')!;
  const lightbox = document.querySelector<HTMLDialogElement>('#lightbox')!;
  const lightboxImage = document.querySelector<HTMLImageElement>('#lightbox-image')!;
  const memberList = document.querySelector<HTMLUListElement>('#member-list')!;
  const memberStatus = document.querySelector<HTMLDivElement>('#member-status')!;
  const memberForm = document.querySelector<HTMLFormElement>('#member-form')!;
  const editForm = document.querySelector<HTMLFormElement>('#edit-form')!;
  const deleteForm = document.querySelector<HTMLFormElement>('#delete-form')!;
  let current: AlbumPayload | null = null;

  function setStatus(element: HTMLDivElement, message = '', state?: 'success' | 'error' | 'info') {
    element.textContent = message;
    if (state) element.dataset.state = state;
    else delete element.dataset.state;
  }

  async function errorMessage(response: Response) {
    try {
      const body = await response.json() as { error?: unknown };
      if (typeof body.error === 'string') return body.error;
    } catch { /* fallback below */ }
    return '処理を完了できませんでした。時間をおいてもう一度お試しください。';
  }

  function bytes(value: number) {
    if (value < 1024 * 1024) return `${Math.max(1, Math.round(value / 1024))} KB`;
    return `${(value / (1024 * 1024)).toFixed(1)} MB`;
  }

  function clearChildren(element: HTMLElement) { element.replaceChildren(); }

  function createAction(label: string, className: string, handler: () => void) {
    const button = document.createElement('button');
    button.type = 'button'; button.className = className; button.textContent = label; button.addEventListener('click', handler);
    return button;
  }

  function renderActions(payload: AlbumPayload) {
    clearChildren(actionsElement);
    if (!payload.isOwner) return;
    actionsElement.append(
      createAction('参加者を管理', 'button button-secondary compact-button', async () => { membersDialog.showModal(); await loadMembers(); }),
      createAction('編集', 'button button-secondary compact-button', () => {
        (document.querySelector<HTMLInputElement>('#edit-album-title')!).value = payload.album.title;
        (document.querySelector<HTMLTextAreaElement>('#edit-album-description')!).value = payload.album.description || '';
        editDialog.showModal();
      }),
      createAction('削除', 'quiet-danger', () => deleteDialog.showModal()),
    );
  }

  function createEmptyPhotos(canUpload: boolean) {
    const empty = document.createElement('div'); empty.className = 'empty-photos';
    const icon = document.createElement('span'); icon.textContent = '□'; icon.setAttribute('aria-hidden', 'true');
    const heading = document.createElement('h3'); heading.textContent = canUpload ? 'まだ写真がありません' : 'まだ写真がありません';
    const text = document.createElement('p'); text.textContent = canUpload ? '上のエリアから最初の写真を追加しましょう。' : '参加者が写真を追加すると、ここに表示されます。';
    empty.append(icon, heading, text); return empty;
  }

  function renderPhotos(payload: AlbumPayload) {
    clearChildren(grid); grid.setAttribute('aria-busy', 'false'); photoCount.textContent = String(payload.images.length);
    if (payload.images.length === 0) { grid.classList.add('is-empty'); grid.append(createEmptyPhotos(payload.canUpload)); return; }
    grid.classList.remove('is-empty');
    payload.images.forEach((photo) => {
      const figure = document.createElement('figure'); figure.className = 'photo-card';
      const open = document.createElement('button'); open.type = 'button'; open.className = 'photo-open'; open.setAttribute('aria-label', `${photo.filename}を拡大表示`);
      const image = document.createElement('img'); image.src = `/api/image/${photo.id}`; image.alt = photo.filename; image.loading = 'lazy'; image.decoding = 'async';
      open.append(image); open.addEventListener('click', () => { lightboxImage.src = image.src; lightboxImage.alt = photo.filename; lightbox.showModal(); });
      figure.append(open);
      const caption = document.createElement('figcaption'); const name = document.createElement('span'); name.textContent = photo.filename; const size = document.createElement('small'); size.textContent = bytes(photo.file_size); caption.append(name, size); figure.append(caption);
      if (payload.isOwner) {
        const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'photo-remove'; remove.textContent = '×'; remove.setAttribute('aria-label', `${photo.filename}を削除`);
        remove.addEventListener('click', async () => { if (window.confirm(`「${photo.filename}」を削除しますか？`)) await deletePhoto(photo.id); }); figure.append(remove);
      }
      grid.append(figure);
    });
  }

  function render(payload: AlbumPayload) {
    current = payload; titleElement.textContent = payload.album.title; descriptionElement.textContent = payload.album.description || '説明はまだ追加されていません。';
    roleElement.textContent = payload.isOwner ? 'YOUR ALBUM' : (payload.permission === 'viewer' ? 'VIEW ONLY' : 'SHARED ALBUM');
    permissionNote.textContent = payload.canUpload ? '写真を追加できます' : '閲覧のみの参加者です';
    uploadSection.hidden = !payload.canUpload; renderActions(payload); renderPhotos(payload);
  }

  async function loadAlbum(announce = false) {
    grid.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch(`/api/albums/${albumId}`, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error(await errorMessage(response));
      render(await response.json() as AlbumPayload);
      if (announce) setStatus(status, 'アルバムを更新しました。', 'success');
    } catch (error) {
      grid.setAttribute('aria-busy', 'false'); titleElement.textContent = 'アルバムを表示できません'; descriptionElement.textContent = error instanceof Error ? error.message : '時間をおいてもう一度お試しください。'; setStatus(status, descriptionElement.textContent, 'error');
    }
  }

  function progressMessage(completed: number, total: number, failed: number) {
    return failed > 0 ? `${completed}/${total} 枚を追加しました。${failed} 枚は追加できませんでした。` : `${completed}/${total} 枚を追加しました。`;
  }

  async function uploadFiles(fileList: FileList | File[]) {
    if (!current?.canUpload || fileList.length === 0) return;
    const files = Array.from(fileList); let completed = 0; let failed = 0;
    uploadArea.setAttribute('aria-busy', 'true'); setStatus(status, '', undefined); progress.textContent = `0/${files.length} 枚を追加しています…`;
    for (const file of files) {
      const form = new FormData(); form.append('file', file); form.append('albumId', albumId);
      try {
        const response = await fetch('/api/upload', { method: 'POST', body: form });
        if (!response.ok) throw new Error(await errorMessage(response));
        completed += 1;
      } catch (error) { failed += 1; setStatus(status, error instanceof Error ? error.message : '一部の写真を追加できませんでした。', 'error'); }
      progress.textContent = progressMessage(completed, files.length, failed);
    }
    uploadArea.removeAttribute('aria-busy'); input.value = ''; await loadAlbum(false);
    setStatus(status, progressMessage(completed, files.length, failed), failed ? 'error' : 'success');
  }

  async function deletePhoto(photoId: string) {
    try {
      const response = await fetch(`/api/image/${photoId}`, { method: 'DELETE' });
      if (!response.ok) throw new Error(await errorMessage(response));
      await loadAlbum(false); setStatus(status, '写真を削除しました。', 'success');
    } catch (error) { setStatus(status, error instanceof Error ? error.message : '写真を削除できませんでした。', 'error'); }
  }

  function createMemberRow(member: Member) {
    const item = document.createElement('li'); const info = document.createElement('div'); const email = document.createElement('strong'); email.textContent = member.member_email; const role = document.createElement('span'); role.textContent = member.permission === 'viewer' ? '閲覧のみ' : '閲覧・写真追加'; info.append(email, role);
    const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'member-remove'; remove.textContent = '削除'; remove.addEventListener('click', async () => {
      if (!window.confirm(`${member.member_email} を参加者から外しますか？`)) return;
      try { const response = await fetch(`/api/albums/${albumId}/members?email=${encodeURIComponent(member.member_email)}`, { method: 'DELETE' }); if (!response.ok) throw new Error(await errorMessage(response)); setStatus(memberStatus, '参加者を削除しました。', 'success'); await loadMembers(); } catch (error) { setStatus(memberStatus, error instanceof Error ? error.message : '参加者を削除できませんでした。', 'error'); }
    }); item.append(info, remove); return item;
  }

  async function loadMembers() {
    memberList.replaceChildren(); setStatus(memberStatus, '', undefined);
    try {
      const response = await fetch(`/api/albums/${albumId}/members`, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error(await errorMessage(response));
      const body = await response.json() as { members?: Member[] }; const members = Array.isArray(body.members) ? body.members : [];
      if (members.length === 0) { const item = document.createElement('li'); item.className = 'members-empty'; item.textContent = 'まだ参加者はいません。'; memberList.append(item); return; }
      members.forEach((member) => memberList.append(createMemberRow(member)));
    } catch (error) { setStatus(memberStatus, error instanceof Error ? error.message : '参加者を取得できませんでした。', 'error'); }
  }

  uploadArea.addEventListener('click', () => input.click()); uploadArea.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); input.click(); } }); input.addEventListener('change', () => { if (input.files) uploadFiles(input.files); });
  ['dragenter', 'dragover'].forEach((name) => uploadArea.addEventListener(name, (event) => { event.preventDefault(); uploadArea.classList.add('is-dragging'); })); ['dragleave', 'drop'].forEach((name) => uploadArea.addEventListener(name, (event) => { event.preventDefault(); uploadArea.classList.remove('is-dragging'); })); uploadArea.addEventListener('drop', (event) => { const files = event.dataTransfer?.files; if (files) uploadFiles(files); });
  document.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((button) => button.addEventListener('click', () => document.querySelector<HTMLDialogElement>(`#${button.dataset.close}`)?.close()));
  memberForm.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(memberForm); const button = memberForm.querySelector<HTMLButtonElement>('button[type="submit"]')!; button.disabled = true; try { const response = await fetch(`/api/albums/${albumId}/members`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: data.get('email'), permission: data.get('permission') }) }); if (!response.ok) throw new Error(await errorMessage(response)); memberForm.reset(); setStatus(memberStatus, '参加者を追加しました。Cloudflare Accessの許可ポリシーもご確認ください。', 'success'); await loadMembers(); } catch (error) { setStatus(memberStatus, error instanceof Error ? error.message : '参加者を追加できませんでした。', 'error'); } finally { button.disabled = false; } });
  editForm.addEventListener('submit', async (event) => { const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null; if (submitter?.value === 'cancel') return; event.preventDefault(); const button = document.querySelector<HTMLButtonElement>('#edit-submit')!; button.disabled = true; const data = new FormData(editForm); try { const response = await fetch(`/api/albums/${albumId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: data.get('title'), description: data.get('description') }) }); if (!response.ok) throw new Error(await errorMessage(response)); editDialog.close(); await loadAlbum(false); setStatus(status, 'アルバムを更新しました。', 'success'); } catch (error) { setStatus(status, error instanceof Error ? error.message : 'アルバムを更新できませんでした。', 'error'); } finally { button.disabled = false; } });
  deleteForm.addEventListener('submit', async (event) => { const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null; if (submitter?.value === 'cancel') return; event.preventDefault(); const button = document.querySelector<HTMLButtonElement>('#delete-submit')!; button.disabled = true; try { const response = await fetch(`/api/albums/${albumId}`, { method: 'DELETE' }); if (!response.ok) throw new Error(await errorMessage(response)); window.location.assign('/albums'); } catch (error) { setStatus(status, error instanceof Error ? error.message : 'アルバムを削除できませんでした。', 'error'); button.disabled = false; deleteDialog.close(); } });
  loadAlbum();
</script>

<style>
  .album-page { min-height: calc(100vh - 170px); padding: 42px 0 92px; }.back-link { display: inline-flex; gap: 9px; color: var(--ink-soft); font-size: 14px; font-weight: 700; text-decoration: none; }.back-link:hover { color: var(--ink); }.album-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin: 30px 0 34px; }.album-title-area h1 { margin: 0; font-size: clamp(35px, 5vw, 55px); letter-spacing: -.065em; line-height: 1.1; }.album-title-area p:not(.eyebrow) { max-width: 650px; margin: 13px 0 0; color: var(--ink-soft); line-height: 1.75; }.album-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 9px; }.compact-button { min-height: 40px; padding: 9px 12px; font-size: 13px; }.quiet-danger { padding: 9px 7px; border: 0; background: transparent; color: #a84731; font-size: 13px; font-weight: 750; }.quiet-danger:hover { text-decoration: underline; }.upload-section { margin: 0 0 48px; }.upload-area { display: flex; align-items: center; justify-content: center; gap: 18px; padding: 30px; border: 2px dashed #b8c8d7; border-radius: 18px; background: #fff; text-align: left; transition: border-color .18s ease, background .18s ease; }.upload-area:hover, .upload-area.is-dragging { border-color: #2a9586; background: #f2faf8; }.upload-area[aria-busy="true"] { cursor: wait; opacity: .7; }.upload-icon { display: grid; width: 45px; height: 45px; flex: 0 0 auto; place-items: center; border-radius: 12px; background: var(--mint); color: #146257; font-size: 26px; }.upload-area h2 { margin: 0; font-size: 17px; letter-spacing: -.03em; }.upload-area p { margin: 5px 0 0; color: var(--ink-soft); font-size: 13px; line-height: 1.6; }.upload-progress { min-height: 20px; margin: 10px 0 0; color: var(--ink-soft); font-size: 13px; text-align: center; }.section-bar { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 18px; }.section-bar h2 { margin: 0; font-size: 22px; letter-spacing: -.04em; }.section-bar h2 span { color: var(--ink-soft); font-size: 14px; font-weight: 600; }.section-bar p { margin: 0; color: var(--ink-soft); font-size: 13px; }.image-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 13px; }.image-grid.is-empty { display: block; }.photo-card { position: relative; min-width: 0; margin: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: #fff; }.photo-open { display: block; width: 100%; padding: 0; border: 0; background: #e7edf3; }.photo-open img { display: block; width: 100%; aspect-ratio: 1 / .84; object-fit: cover; transition: transform .25s ease; }.photo-open:hover img { transform: scale(1.035); }.photo-card figcaption { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 9px 10px; color: var(--ink-soft); font-size: 11px; }.photo-card figcaption span { overflow: hidden; color: var(--ink); font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }.photo-card figcaption small { flex: 0 0 auto; }.photo-remove { position: absolute; top: 8px; right: 8px; display: grid; width: 26px; height: 26px; place-items: center; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; background: rgba(16,35,63,.76); color: #fff; font-size: 19px; line-height: 1; opacity: 0; transition: opacity .16s ease; }.photo-card:hover .photo-remove, .photo-remove:focus-visible { opacity: 1; }.photo-remove:hover { background: #a84731; }.empty-photos { padding: 60px 18px; border: 1px dashed #b9c8d9; border-radius: 16px; background: #fff; text-align: center; }.empty-photos > span { display: grid; width: 40px; height: 40px; margin: 0 auto 13px; place-items: center; border-radius: 9px; background: var(--mint); color: #146257; font-size: 23px; }.empty-photos h3 { margin: 0; font-size: 18px; }.empty-photos p { margin: 8px 0 0; color: var(--ink-soft); font-size: 13px; }
  dialog { width: min(620px, calc(100% - 28px)); padding: 0; border: 0; border-radius: 18px; box-shadow: 0 28px 80px rgba(16,35,63,.28); }dialog::backdrop { background: rgba(16,35,63,.54); backdrop-filter: blur(3px); }.dialog-content { padding: 30px; }.dialog-heading { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 14px; }.dialog-heading h2 { margin: 0; font-size: 24px; letter-spacing: -.05em; }.dialog-close { display: grid; width: 36px; height: 36px; place-items: center; border: 0; border-radius: 50%; background: #eff3f7; color: var(--ink); font-size: 24px; }.dialog-close:hover { background: #e0e8f0; }.dialog-lead { margin: 0; color: var(--ink-soft); font-size: 13px; line-height: 1.75; }label { display: grid; gap: 8px; margin-top: 18px; color: var(--ink); font-size: 13px; font-weight: 750; }input, textarea, select { width: 100%; padding: 11px 12px; border: 1px solid #cbd6e2; border-radius: 9px; background: #fff; color: var(--ink); font-size: 14px; font-weight: 500; outline: none; }textarea { resize: vertical; }.member-form { display: grid; grid-template-columns: minmax(0, 1fr) 145px auto; align-items: end; gap: 10px; margin-top: 8px; }.member-form .button { min-height: 41px; padding: 9px 12px; font-size: 13px; }.member-list { margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }.member-list li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--line); }.member-list strong, .member-list span { display: block; }.member-list strong { font-size: 14px; }.member-list span { margin-top: 3px; color: var(--ink-soft); font-size: 12px; }.member-remove { border: 0; background: transparent; color: #a84731; font-size: 12px; font-weight: 750; }.members-empty { justify-content: center !important; color: var(--ink-soft); font-size: 13px; }.dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 26px; }.dialog-actions .button